{
  "name": "qianfan-crm",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "千帆 CRM · 独立重建版",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "demo": "node scripts/demo.mjs",
    "init": "node scripts/init.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:module": "node scripts/test-module.mjs",
    "check": "node scripts/check.mjs",
    "backup": "node scripts/backup.mjs",
    "build:widgets": "node node_modules/vite/bin/vite.js build --config widgets/vite.config.mjs"
  },
  "dependencies": {
    "@arco-design/web-react": "2.66.18",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
