NODE_ENV=production
HOST=127.0.0.1
PORT=3100
DB_PATH=data/crm.sqlite
PUBLIC_ORIGIN=https://crm.example.invalid
# 初始化时通过受控环境变量提供 ADMIN_PASSWORD；初始化后移除。
# 不要在生产环境开启 DEMO_MODE。
# 钉钉企业应用：密钥只通过受控环境配置，不能写进前端或Git。
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# DINGTALK_CORP_ID=
# DINGTALK_REDIRECT_URI=https://crm.example.invalid/
# DINGTALK_ONLY=true
# DINGTALK_PPL_BASE_ID=
# DINGTALK_PPL_SHEET_ID=
# DINGTALK_CUSTOMER_SHEET_ID=
# DINGTALK_OPERATOR_UNION_ID=

# 赢单战报：默认关闭，仅 Linux 正式服务器执行真实投递。
# 正式服务入口设置 CRM_RUNTIME_ENVIRONMENT=server；本地不要设置。
# 可复用上方 DINGTALK_CLIENT_ID / DINGTALK_CLIENT_SECRET。
# 使用独立应用时，下列 CLIENT_ID / CLIENT_SECRET 必须成对提供。
# DINGTALK_WIN_REPORT_CLIENT_ID=
# DINGTALK_WIN_REPORT_CLIENT_SECRET=
# DINGTALK_WIN_REPORT_ROBOT_CODE=
# DINGTALK_WIN_REPORT_TEMPLATE_ID=
# DINGTALK_WIN_REPORT_TEST_GROUP=
# DINGTALK_WIN_REPORT_WANJIN_GROUP=
# 群及模板配置、测试顺序和启用步骤见 integrations/dingtalk/README.md。
